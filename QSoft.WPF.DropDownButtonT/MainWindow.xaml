<Window x:Class="QSoft.WPF.DropDownButtonT.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QSoft.WPF.DropDownButtonT"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel Margin="10">
        <TextBox x:Name="text_log" DockPanel.Dock="Bottom" Height="150" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
        <StackPanel>
            <!-- MenuFlyout equivalent -->
            <local:DropDownButton  HorizontalAlignment="Left" Margin="0,0,0,10">
                <local:DropDownButton.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TTTest"/>
                        <Ellipse Fill="Green" Width="5" Height="5"/>
                    </StackPanel>
                </local:DropDownButton.Content>
                <local:DropDownButton.Flyout>
                    <Border CornerRadius="6" Background="Red" Width="150">
                        <StackPanel>
                            <TextBlock Text="Test 1"/>
                            <TextBlock Text="Test 1"/>
                        </StackPanel>
                    </Border>
                </local:DropDownButton.Flyout>
            </local:DropDownButton>
        </StackPanel>
    </DockPanel>
</Window>
