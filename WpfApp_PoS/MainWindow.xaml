<Window x:Class="WpfApp_PoS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp_PoS"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="MainWindow" Height="450" Width="800">
    <TabControl>
        <TabItem Header="Step1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image x:Name="image"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <RadioButton IsChecked="True" x:Name="radiobutton_mail" Click="radiobutton_mail_Click">Mail</RadioButton>
                        <RadioButton x:Name="radiobutton_text" Click="radiobutton_text_Click">Text</RadioButton>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Column="1" Text="{Binding SendLicense}" IsReadOnlyCaretVisible="True" IsReadOnly="True"/>
                    <TextBlock Grid.Row="1">
                        <Hyperlink NavigateUri="{Binding MailTo}">MailTo</Hyperlink>
                    </TextBlock>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Step2">
            <local:Step2/>
        </TabItem>
    </TabControl>
    
</Window>
